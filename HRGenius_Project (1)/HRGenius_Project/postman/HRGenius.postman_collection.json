{
  "info": {
    "name": "HRGenius API Starter",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"Admin@12345\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Anita Sharma\",\"email\":\"anita.sharma@example.com\",\"phone\":\"9876543210\",\"designation\":\"Software Engineer\",\"departmentId\":1,\"dateOfJoining\":\"2026-08-01\"}"
        },
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "List Employees",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/employees?page=0&size=20&search=Anita"
      }
    },
    {
      "name": "List Departments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/departments"
      }
    }
  ]
}